// for loop 10 Questions
void main() {

  // 1. Print numbers from 1 to 10
  for (int i = 1; i <= 10; i++) {
    print(i);
  }
  print("__________________________________________________");

  // 2. Print numbers from 20 to 1
  for (int i = 20; i >= 1; i--) {
    print(i);
  }
  print("__________________________________________________");

  // 3. Print even numbers from 1 to 50
  for (int i = 1; i <= 50; i++) {
    if (i % 2 == 0) {
      print(i);
    }
  }
  print("__________________________________________________");

  // 4. Print odd numbers from 1 to 50
  for (int i = 1; i <= 50; i++) {
    if (i % 2 != 0) {
      print(i);
    }
  }
  print("__________________________________________________");

  // 5. Table of 7
  for (int i = 1; i <= 10; i++) {
    print("7 x $i = ${7 * i}");
  }
  print("__________________________________________________");

  // 6. Sum of numbers from 1 to 100
  int sum = 0;

  for (int i = 1; i <= 100; i++) {
    sum = sum + i;
  }

  print("Sum = $sum");
  print("__________________________________________________");

  // 7. Factorial of 5
  int number = 5;
  int factorial = 1;

  for (int i = 1; i <= number; i++) {
    factorial = factorial * i;
  }

  print("Factorial = $factorial");
  print("__________________________________________________");

  // 8. Print squares from 1 to 10
  for (int i = 1; i <= 10; i++) {
    print(i * i);
  }
  print("__________________________________________________");

  // 9. Count numbers divisible by 5
  int count = 0;

  for (int i = 1; i <= 100; i++) {
    if (i % 5 == 0) {
      count++;
    }
  }

  print("Count = $count");
  print("__________________________________________________");

  // 10. Print star pattern
  for (int i = 1; i <= 5; i++) {
    for (int j = 1; j <= i; j++) {
      print("*");
    }
    print("");
  }
  print("__________________________________________________");



// for-in loop 10 Questions

