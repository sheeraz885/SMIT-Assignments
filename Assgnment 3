  var nums = [10, 25, 8, 14, 31, 6];
  var sum = 0;

  for (var num in nums) {
    sum = sum + num;
  }

  print("Sum = $sum");
  print("__________________________________________________");


  // 4. Find the largest number
  var numbers2 = [10, 25, 8, 14, 31, 6];
  var largest = numbers2[0];

  for (var num in numbers2) {
    if (num > largest) {
      largest = num;
    }
  }

  print("Largest number = $largest");
  print("__________________________________________________");


  // 5. Find the smallest number
  var numbers3 = [10, 25, 8, 14, 31, 6];
  var smallest = numbers3[0];

  for (var num in numbers3) {
    if (num < smallest) {
      smallest = num;
    }
  }

  print("Smallest number = $smallest");
  print("__________________________________________________");


  // 6. Count even numbers
  var numbers4 = [10, 25, 8, 14, 31, 6];
  var count = 0;

  for (var num in numbers4) {
    if (num % 2 == 0) {
      count++;
    }
  }

  print("Even numbers = $count");
  print("__________________________________________________");


  // 7. Print names with more than five characters
  var names2 = ["Ali", "Ahmed", "Usman", "Ayesha", "Ibrahim"];

  for (var name in names2) {
    if (name.length > 5) {
      print(name);
    }
  }
  print("__________________________________________________");


  // 8. Sum of all odd numbers
  var numbers5 = [10, 25, 8, 14, 31, 6, 7, 9];
